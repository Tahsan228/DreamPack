{
  "name": "dreampack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mix multiple Minecraft resource packs into one, asset by asset.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:glyphs": "node scripts/audit-glyphs.mjs",
    "testpacks": "node scripts/make-test-packs.mjs",
    "shot": "node scripts/shot.mjs",
    "shot:3d": "node scripts/shot3d.mjs",
    "tour": "node scripts/tour.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "fflate": "^0.8.2",
    "idb": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
